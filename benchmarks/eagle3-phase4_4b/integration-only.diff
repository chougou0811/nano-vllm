+            for entry in payload["entries"]:
+                state = self._eagle_batch_states[entry["seq_id"]]
+                cursor = state["cursor"]
+                positions = torch.arange(cursor,device=self.kv_cache.device)
+                blocks = torch.tensor(state["blocks"],device=positions.device)
